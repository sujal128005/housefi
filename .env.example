# Housefi backend environment. Copy to .env for local development only.
# Production values live in AWS Secrets Manager / SSM Parameter Store. Never commit real values.

NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated origins allowed by CORS (web preview of the app).
CORS_ORIGINS=http://localhost:8081
# Added by the backend (not in the handoff): set TRUST_PROXY=true behind a load balancer so client IPs are real.
TRUST_PROXY=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Default per-IP requests per minute for routes without their own limit.
RATE_LIMIT_PER_MIN=120

# PostgreSQL 16 with PostGIS
DATABASE_URL=postgresql://housefi:housefi@localhost:5432/housefi?schema=public
# Redis (rate limits, BullMQ queues, pub/sub for live updates)
REDIS_URL=redis://localhost:6379

# Auth
# Ed25519 key pair (PEM, base64-encoded) for access tokens.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# 32+ random bytes, base64. Used to HMAC OTP codes and refresh tokens before storing.
OTP_PEPPER_B64=
TOKEN_PEPPER_B64=
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_AFTER_SEC=30

# Field encryption (PII). Production: AWS KMS key; local: a 32-byte base64 key.
KMS_KEY_ID=
LOCAL_DATA_KEY_B64=
# 32+ random bytes, base64. HMAC for phone-number lookup.
PHONE_HASH_KEY_B64=

# SMS (OTP) - MSG91. In development leave empty: codes are printed to the server log only.
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=HOUSFI

# Payments - Razorpay (use TEST keys until go-live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Files - S3 (S3Mock locally, see docker-compose.yml)
AWS_REGION=ap-south-1
S3_BUCKET_UPLOADS=housefi-dev-uploads
S3_ENDPOINT=http://localhost:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
UPLOAD_URL_TTL_SEC=300

# Push notifications (Expo push service)
EXPO_ACCESS_TOKEN=

# Masked calls / IVR - Exotel (later)
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=

# AI (later; v1 uses rule-based stand-ins)
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-sonnet-5-5
SPEECH_TO_TEXT_PROVIDER=

# Business rules (defaults match the app)
VISIT_FEE_RUPEES=49
QUOTE_MIN_RUPEES=100
TECH_VISIT_SHARE_RUPEES=30
TECH_LABOUR_SHARE_PERCENT=80
OFFER_TIMEOUT_SEC=45
MATCHING_DELAYED_AFTER_MIN=10
MATCHING_GIVE_UP_AFTER_MIN=30
UNPAID_BOOKING_EXPIRY_MIN=30
INSTANT_HOURS=07-21
START_CODE_MAX_ATTEMPTS=5
