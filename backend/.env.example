# Housefi backend environment. Copy to .env for local development ("npm run setup" does it and fills the secrets).
# Production: generate the secrets with "node scripts/prod-secrets.mjs" (see docs/DEPLOY.md) and keep them only in
# the server's .env.production (chmod 600) or your host's secret store. Never commit real values.

NODE_ENV=development
PORT=4000
# The API's public address (https:// in production, e.g. https://api.housefi.tech).
PUBLIC_BASE_URL=http://localhost:4000
# Comma-separated browser origins allowed by CORS: the app's web preview and the website (Technician ID check page).
CORS_ORIGINS=http://localhost:8081,https://housefi.tech
# Reverse proxies in front of the API (Caddy / a load balancer = 1; Cloudflare in front of that = 2). 0 = none.
TRUST_PROXY=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Default per-IP requests per minute for routes without their own limit.
RATE_LIMIT_PER_MIN=120

# PostgreSQL 16 with PostGIS
DATABASE_URL=postgresql://housefi:housefi@localhost:5432/housefi?schema=public
# Redis (rate limits, live updates, chat memory). Production: with a password, rediss:// when offered.
REDIS_URL=redis://localhost:6379

# ---------- Sign-in ----------
# Ed25519 key pair (PEM, base64-encoded) for access tokens.
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# 32+ random bytes, base64. Used to HMAC OTP codes and refresh tokens before storing.
OTP_PEPPER_B64=
TOKEN_PEPPER_B64=
OTP_TTL_SEC=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_AFTER_SEC=30
# Whole-service SMS budget for sign-in codes (a flood of requests cannot drain the SMS balance).
OTP_SMS_PER_MINUTE=60
OTP_SMS_PER_HOUR=1000
OTP_SMS_PER_DAY=8000
# Progressive lock per phone number, "wrong codes:lock" steps (m, h, d). The last step locks the account until
# support unlocks it ("npm run support -- unlock <phone>") or the time passes.
OTP_LOCK_STEPS=5:10m,3:1h,1:24h,1:21d
# Team demo numbers (10 digits, comma-separated) and their fixed 6-digit code. Leave empty here; set them only on
# the server. Demo bookings use simulated payments and only reach demo technicians.
DEMO_PHONES=
DEMO_OTP_CODE=

# ---------- Data protection ----------
# Field encryption master keys, versioned: "1:<base64 32 bytes>" (add "2:..." to rotate; DATA_KEY_ACTIVE picks the
# one used for new data). Development may use LOCAL_DATA_KEY_B64 instead (never in production).
DATA_KEYS_B64=
DATA_KEY_ACTIVE=
LOCAL_DATA_KEY_B64=
# Optional alternative to DATA_KEYS_B64: an AWS KMS key.
KMS_KEY_ID=
# 32+ random bytes, base64: HMAC key for looking up phone numbers without storing them in clear.
PHONE_HASH_KEY_B64=

# ---------- SMS (MSG91) ----------
# console = print codes to the server log (development only); msg91 = real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
# DLT-approved OTP template.
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=HOUSFI
# Optional: DLT-approved template for the job details SMS after a keypad-phone acceptance (variables code, name, address).
MSG91_JOB_TEMPLATE_ID=

# ---------- Payments (Razorpay) ----------
# rzp_test_... outside production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Photos and voice notes (S3-compatible: DigitalOcean Spaces, AWS S3, local S3Mock) ----------
# Local S3Mock from docker-compose.yml. Spaces: S3_ENDPOINT=https://blr1.digitaloceanspaces.com, S3_REGION=blr1.
S3_ENDPOINT=http://localhost:9090
S3_REGION=
AWS_REGION=ap-south-1
S3_BUCKET_UPLOADS=housefi-dev-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
UPLOAD_URL_TTL_SEC=300

# ---------- Push (Expo) ----------
# log = write pushes to the server log (development); expo = real pushes (production).
PUSH_PROVIDER=log
# Only when "enhanced push security" is on in the Expo project.
EXPO_ACCESS_TOKEN=

# ---------- Phone calls (Exotel, docs/TELEPHONY.md) ----------
# off = no calls; exotel = real calls; fake = recorded only (development and tests).
TELEPHONY_PROVIDER=off
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
# The ExoPhone (Housefi's virtual number), e.g. 04012345678.
EXOTEL_CALLER_ID=
EXOTEL_OFFER_FLOW_ID=
# 32+ random characters; part of every Exotel callback URL.
EXOTEL_WEBHOOK_SECRET=
# Optional: only accept Exotel callbacks from these IPs (comma-separated).
TELEPHONY_ALLOWED_IPS=
IVR_OFFER_TIMEOUT_SEC=90
IVR_RING_TIMEOUT_SEC=30
IVR_CIRCUIT_FAILURES=3
IVR_CIRCUIT_OPEN_MIN=5
MASKED_CALL_GRANT_MIN=30

# ---------- AI ----------
# Support chat and problem photos: rules = no model (v1 behaviour); anthropic = Claude; cloudflare = open models on
# Cloudflare Workers AI (free daily allowance; inputs are not used for training). The rules answer whenever a model fails.
AI_PROVIDER=rules
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=claude-opus-5-5
AI_VISION_MODEL=claude-opus-5-5
# AI_PROVIDER=cloudflare: dashboard → account id (32 characters) and an API token from the "Workers AI" template.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_CHAT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_AI_VISION_MODEL=@cf/mistralai/mistral-small-3.1-24b-instruct
AI_TIMEOUT_MS=15000
# none = voice notes stay audio; sarvam = Telugu / English speech-to-text (notes up to 30 s).
SPEECH_TO_TEXT_PROVIDER=none
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4

# ---------- Technician identity ----------
# Where the QR code on a Technician ID card points (the token is appended after "#").
VERIFY_PAGE_URL=https://housefi.tech/t/#
# UIDAI's certificates for Aadhaar Secure QR signatures: base64 of each .cer (or PEM), comma-separated. Without them
# Aadhaar checks are unavailable. On the laptop: download them into a folder, then "deploy\laptop uidai <folder>".
UIDAI_QR_CERT_PEM_B64=
# Technicians need a verified Aadhaar before approval (false only for local testing).
AADHAAR_REQUIRED=true
# Technicians prove each trade (skill exam, or a work video HQ approves) before approval and jobs (false only for local testing).
SKILL_CHECK_REQUIRED=true
# Approve technicians automatically once Aadhaar is genuine, 18+, the name matches and a photo is there (false: by hand).
AUTO_APPROVE_TECHNICIANS=true
# Invoices (PDF after a job): the seller's name and address as printed; GSTIN only once registered for GST.
INVOICE_SELLER_NAME=Housefi
INVOICE_SELLER_ADDRESS=Hyderabad, Telangana, India
INVOICE_GSTIN=
# Super admin portal: its secret host name (kept only here, never linked anywhere). Empty: no portal.
ADMIN_HOST=

# ---------- Business rules (defaults match the app) ----------
VISIT_FEE_RUPEES=49
QUOTE_MIN_RUPEES=100
TECH_VISIT_SHARE_RUPEES=30
TECH_LABOUR_SHARE_PERCENT=80
# Apprentice mode: Housefi pays an apprentice this much per job they helped on; helped jobs before the skill exam;
# apprentices per mentor.
APPRENTICE_SHARE_RUPEES=100
APPRENTICE_JOBS_TARGET=5
MENTOR_MAX_APPRENTICES=2
# Society repair day: visit fee per flat; flats needed (paid) by the cutoff; the most flats; cutoff hour the day before (IST).
SOCIETY_VISIT_FEE_RUPEES=25
SOCIETY_MIN_FLATS=4
SOCIETY_MAX_FLATS=20
SOCIETY_CUTOFF_HOUR=18
OFFER_TIMEOUT_SEC=45
# Offers also go to online technicians within this many km of the customer, whatever their PIN (0 = PIN codes only).
DISPATCH_RADIUS_KM=10
MATCHING_DELAYED_AFTER_MIN=10
MATCHING_GIVE_UP_AFTER_MIN=30
UNPAID_BOOKING_EXPIRY_MIN=30
INSTANT_HOURS=07-21
# Bookings per 2-hour window per category in one PIN area (per-area overrides: slot_capacities table).
SLOT_CAPACITY_PER_WINDOW=10
START_CODE_MAX_ATTEMPTS=5
