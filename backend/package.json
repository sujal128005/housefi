{
  "name": "housefi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Housefi API: home-services marketplace backend (customers + technicians).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node dist/cli/seed.js",
    "db:local": "node scripts/local-db.mjs",
    "catalog:import": "node scripts/import-catalog.mjs",
    "tech": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node dist/cli/technicians.js",
    "payouts": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node dist/cli/payouts.js",
    "coordinators": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node dist/cli/coordinators.js",
    "support": "node node_modules/typescript/bin/tsc -p tsconfig.build.json && node dist/cli/support.js",
    "postinstall": "prisma generate",
    "secrets:prod": "node scripts/prod-secrets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-kms": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "fastify": "5.12.7",
    "ioredis": "^6.0.0",
    "pino": "^9.14.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@swc/core": "^1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2"
  },
  "overrides": {
    "fastify": "$fastify",
    "deepmerge-ts": "8.0.2",
    "argparse@1": "2.0.1"
  }
}
