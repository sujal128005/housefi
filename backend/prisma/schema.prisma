// Housefi database. Models are added feature by feature (auth, catalog, bookings, ...), each with a committed
// migration, following docs/schema.sql. Money is stored in paise (BigInt); the API speaks whole rupees.
// Columns ending in Enc hold AES-256-GCM envelope ciphertext (src/common/crypto); Hash columns hold HMAC-SHA256.
// PostGIS: geography(Point, 4326) columns are Unsupported for Prisma and are read / written with raw SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- enums (mirror the app's src/domain/types.ts) ----------

enum UserRole {
  CUSTOMER
  TECHNICIAN
  COORDINATOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED

  @@map("user_status")
}

enum Locale {
  en
  te

  @@map("locale")
}

// ---------- identity ----------

/// One row per account. The same phone may hold one CUSTOMER and one TECHNICIAN account (separate users).
model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role      UserRole
  phoneEnc  Bytes      @map("phone_enc")
  /// HMAC(phone) for lookup; the phone itself is only stored encrypted.
  phoneHash Bytes      @map("phone_hash")
  nameEnc   Bytes?     @map("name_enc")
  locale    Locale     @default(en)
  status    UserStatus @default(ACTIVE)
  /// A team demo account (DEMO_PHONES): its bookings are simulated and kept apart from real ones.
  isDemo    Boolean    @default(false) @map("is_demo")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens  RefreshToken[]
  addresses      Address[]
  devices        Device[]
  ratingsGiven   Rating[]
  uploads        Upload[]
  notifications  Notification[]
  bookings       Booking[]
  technician     Technician?     @relation("TechnicianUser")
  tickets        SupportTicket[]
  coordinated    Technician[]    @relation("TechnicianCoordinator")
  supportThreads SupportThread[]

  @@unique([role, phoneHash])
  @@map("users")
}

/// One SMS code. The code is stored only as HMAC(pepper, challengeId:code).
model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneHash  Bytes     @map("phone_hash")
  /// Encrypted phone, needed to create the account on success (not in docs/schema.sql; see docs/API-NOTES.md).
  phoneEnc   Bytes     @map("phone_enc")
  role       UserRole
  codeHash   Bytes     @map("code_hash")
  attempts   Int       @default(0)
  /// False for team demo numbers (no SMS). The service-wide SMS budget counts the true ones.
  sendsSms   Boolean   @default(true) @map("sends_sms")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

/// Progressive sign-in lock per phone number after wrong codes (OTP_LOCK_STEPS). Deleted on a correct code, except
/// after the final step: then only support unlocks it (npm run support -- unlock <phone>, audited).
model OtpLockout {
  phoneHash     Bytes     @id @map("phone_hash")
  /// Lock steps reached so far (0 = none).
  level         Int       @default(0) @db.SmallInt
  /// Wrong codes counted towards the next step.
  failures      Int       @default(0)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailureAt DateTime  @map("last_failure_at") @db.Timestamptz(6)

  @@map("otp_lockouts")
}

/// Refresh tokens, stored only as HMAC(pepper, token). Each sign-in starts a family; every refresh replaces the
/// token with a new one in the same family. Presenting a used or revoked token revokes the whole family.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  device    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- catalog (seeded from the app's src/data/catalog.ts: npm run catalog:import, then npm run db:seed) ----------

enum CategoryId {
  PLUMBING
  ELECTRICAL
  AC
  APPLIANCE
  CLEANING
  CARPENTRY

  @@map("category_id")
}

model Category {
  id        CategoryId @id
  nameEn    String     @map("name_en")
  nameTe    String     @map("name_te")
  taglineEn String     @map("tagline_en")
  taglineTe String     @map("tagline_te")
  /// Which artwork the app shows (tap, bulb, snowflake, tv, sponge, saw).
  art       String
  /// Background tint name used by the app (not in docs/schema.sql; the API's Category requires it).
  wash      String
  sort      Int

  services Service[]

  @@map("categories")
}

model Service {
  id                    String     @id
  categoryId            CategoryId @map("category_id")
  nameEn                String     @map("name_en")
  nameTe                String     @map("name_te")
  descriptionEn         String     @map("description_en")
  descriptionTe         String     @map("description_te")
  visitFeePaise         BigInt     @default(4900) @map("visit_fee_paise")
  /// Typical minimum repair (labour + materials); the price check's lower bound.
  repairFromPaise       BigInt     @map("repair_from_paise")
  /// Typical maximum repair; quotes above 1.5x this go to review.
  repairTypicalMaxPaise BigInt     @map("repair_typical_max_paise")
  durationMin           Int        @map("duration_min")
  durationMax           Int        @map("duration_max")
  /// Shown on the service page. Demo values from the app catalog until real ratings exist.
  rating                Float
  reviews               Int
  keywords              String[]   @default([])
  popular               Boolean    @default(false)
  /// Services removed from the catalog are deactivated, never deleted (bookings keep referring to them).
  active                Boolean    @default(true)
  sort                  Int
  /// Set when the service was added or changed in Housefi HQ: the catalogue seed then leaves it as it is.
  editedInHqAt          DateTime?  @map("edited_in_hq_at") @db.Timestamptz(6)

  category Category       @relation(fields: [categoryId], references: [id])
  issues   ServiceIssue[]
  bookings Booking[]
  parts    Part[]

  @@index([categoryId, sort])
  @@map("services")
}

model ServiceIssue {
  id        String @id
  serviceId String @map("service_id")
  nameEn    String @map("name_en")
  nameTe    String @map("name_te")
  sort      Int

  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId, sort])
  @@map("service_issues")
}

// ---------- customers ----------

enum AddressLabel {
  HOME
  WORK
  OTHER

  @@map("address_label")
}

/// Saved addresses. House, street and landmark are encrypted; city, PIN and the coarse locality stay readable because
/// offers show the area to technicians before they accept. Deleting wipes the personal fields (soft delete).
model Address {
  id          String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                                 @map("user_id") @db.Uuid
  label       AddressLabel
  houseEnc    Bytes                                  @map("house_enc")
  streetEnc   Bytes                                  @map("street_enc")
  landmarkEnc Bytes?                                 @map("landmark_enc")
  /// Coarse area shown in job offers ("Banjara Hills"); derived from the street until the app sends one.
  locality    String
  city        String
  pincode     String                                 @db.Char(6)
  /// From the phone's GPS when the customer used "my current location".
  location    Unsupported("geography(Point, 4326)")?
  createdAt   DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ---------- visit slots ----------

/// Per-area capacity overrides: bookings allowed per 2-hour window for one category in one PIN area.
/// Areas without a row use SLOT_CAPACITY_PER_WINDOW.
model SlotCapacity {
  categoryId   CategoryId @map("category_id")
  pincode      String     @db.Char(6)
  maxPerWindow Int        @map("max_per_window")

  @@id([categoryId, pincode])
  @@map("slot_capacities")
}

// ---------- bookings ----------

enum BookingMode {
  INSTANT
  SCHEDULED

  @@map("booking_mode")
}

enum BookingStatus {
  AWAITING_PAYMENT
  PAYMENT_PENDING
  MATCHING
  MATCHING_DELAYED
  UNFULFILLED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  INSPECTING
  QUOTE_SHARED
  IN_PROGRESS
  EXTRA_WORK
  PAYMENT_DUE
  COMPLETED
  CLOSED_NO_REPAIR
  CANCELLED

  @@map("booking_status")
}

/// The first five come from the customer; the last two are set by the system (not sent to the app yet,
/// docs/QUESTIONS.md #4).
enum CancelReason {
  PLANS_CHANGED
  FIXED
  TOO_LONG
  MISTAKE
  OTHER
  UNPAID_EXPIRED
  UNFULFILLED_EXPIRED
  /// Cancelled by Housefi (a super admin, from the portal).
  BY_HOUSEFI

  @@map("cancel_reason")
}

enum CloseReason {
  CUSTOMER_DECLINED
  CUSTOMER_UNAVAILABLE
  CANNOT_COMPLETE

  @@map("close_reason")
}

enum ActorType {
  CUSTOMER
  TECHNICIAN
  COORDINATOR
  ADMIN
  SYSTEM

  @@map("actor_type")
}

/// One booking = one job. The customer sees it as a Booking, the assigned technician as a Job (same id).
model Booking {
  id                    String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Short human code, "HF-48291".
  code                  String                                 @unique
  customerId            String                                 @map("customer_id") @db.Uuid
  serviceId             String                                 @map("service_id")
  categoryId            CategoryId                             @map("category_id")
  /// The full address at booking time (encrypted JSON), so later edits or deletion of the saved address
  /// do not change the booking.
  addressSnapshotEnc    Bytes                                  @map("address_snapshot_enc")
  /// Shown to offered technicians before they accept.
  locality              String
  city                  String
  pincode               String                                 @db.Char(6)
  location              Unsupported("geography(Point, 4326)")?
  issueIds              String[]                               @default([]) @map("issue_ids")
  notes                 String                                 @default("")
  voiceTranscript       String?                                @map("voice_transcript")
  voiceObjectKey        String?                                @map("voice_object_key")
  voiceDurationSec      Int?                                   @map("voice_duration_sec")
  timeMode              BookingMode                            @map("time_mode")
  windowDate            DateTime?                              @map("window_date") @db.Date
  windowStartHour       Int?                                   @map("window_start_hour") @db.SmallInt
  windowEndHour         Int?                                   @map("window_end_hour") @db.SmallInt
  preferWomenRated      Boolean                                @default(false) @map("prefer_women_rated")
  /// Apprentice mode: the customer agreed that a trainee may come along with the technician (supervised, ID-checked).
  allowTrainee          Boolean                                @default(false) @map("allow_trainee")
  /// The technician's apprentice on this job (added by the technician before arriving; the customer can say no).
  traineeId             String?                                @map("trainee_id") @db.Uuid
  traineeAddedAt        DateTime?                              @map("trainee_added_at") @db.Timestamptz(6)
  /// The technician's answer after the job: the trainee came and helped (credits the apprentice share) or not.
  traineeHelped         Boolean?                               @map("trainee_helped")
  /// Made by a team demo account: simulated payments, demo technicians only, no payouts.
  isDemo                Boolean                                @default(false) @map("is_demo")
  status                BookingStatus
  /// The assigned technician.
  technicianId          String?                                @map("technician_id") @db.Uuid
  /// "Book the same technician again": offered to this technician first (from the customer's earlier booking with them).
  preferredTechnicianId String?                                @map("preferred_technician_id") @db.Uuid
  /// 4 digits the customer reads out at the door; encrypted because the customer must see it.
  arrivalCodeEnc        Bytes                                  @map("arrival_code_enc")
  startCodeAttempts     Int                                    @default(0) @map("start_code_attempts")
  etaMin                Int?                                   @map("eta_min")
  /// When the current search for a technician started (MATCHING_DELAYED after 10 min, UNFULFILLED after 30).
  matchingStartedAt     DateTime?                              @map("matching_started_at") @db.Timestamptz(6)
  /// When the current technician accepted (instant visits are reassigned if the trip has not started 10 min later).
  assignedAt            DateTime?                              @map("assigned_at") @db.Timestamptz(6)
  workStarted           Boolean                                @default(false) @map("work_started")
  cancelReason          CancelReason?                          @map("cancel_reason")
  closeReason           CloseReason?                           @map("close_reason")
  idempotencyKey        String                                 @map("idempotency_key")
  /// SHA-256 of the create request, so a reused Idempotency-Key with a different body is refused.
  idempotencyHash       Bytes                                  @map("idempotency_hash")
  /// Incremented on every change.
  version               Int                                    @default(0)
  /// Chat between the customer and the technician: up to when each side last read it (unread counts).
  chatCustomerReadAt    DateTime?                              @map("chat_customer_read_at") @db.Timestamptz(6)
  chatTechReadAt        DateTime?                              @map("chat_tech_read_at") @db.Timestamptz(6)
  /// A free warranty revisit: the completed booking it re-does (one claim per booking, within 15 days).
  warrantyOfId          String?                                @unique @map("warranty_of") @db.Uuid
  /// Offered before other searching jobs (warranty revisits).
  priority              Boolean                                @default(false)
  createdAt             DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  service             Service             @relation(fields: [serviceId], references: [id])
  customer            User                @relation(fields: [customerId], references: [id])
  technician          Technician?         @relation("BookingTechnician", fields: [technicianId], references: [userId])
  preferredTechnician Technician?         @relation("BookingPreferredTechnician", fields: [preferredTechnicianId], references: [userId], onDelete: SetNull)
  trainee             Technician?         @relation("BookingTrainee", fields: [traineeId], references: [userId], onDelete: SetNull)
  events              BookingEvent[]
  payments            Payment[]
  offers              JobOffer[]
  quotes              Quote[]
  tickets             SupportTicket[]
  ledger              EarningsLedger[]
  rating              Rating?
  reminders           BookingReminder[]
  uploads             Upload[]
  chatMessages        ChatMessage[]
  notifications       Notification[]
  queueEntry          DispatchQueueEntry?
  callGrants          CallGrant[]
  warrantyOf          Booking?            @relation("BookingWarranty", fields: [warrantyOfId], references: [id])
  warrantyClaim       Booking?            @relation("BookingWarranty")
  invoice             Invoice?
  couponRedemption    CouponRedemption?

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([technicianId, status])
  @@index([status, windowDate])
  @@index([categoryId, pincode, windowDate, windowStartHour])
  @@index([traineeId])
  @@map("bookings")
}

/// Timeline and audit of every status change.
/// Reminders already sent (each once per booking and key).
model BookingReminder {
  bookingId String   @map("booking_id") @db.Uuid
  /// PAY, SOON, QUOTE:<event id>, RATE
  key       String
  sentAt    DateTime @map("sent_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([bookingId, key])
  @@map("booking_reminders")
}

model BookingEvent {
  id        BigInt        @id @default(autoincrement())
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  actorType ActorType     @map("actor_type")
  actorId   String?       @map("actor_id") @db.Uuid
  meta      Json          @default("{}")
  at        DateTime      @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, at])
  @@map("booking_events")
}

// ---------- payments (Razorpay) ----------

enum PaymentKind {
  VISIT
  FINAL

  @@map("payment_kind")
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  CASH

  @@map("payment_method")
}

enum PaymentState {
  DUE
  PROCESSING
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_state")
}

model Payment {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String         @map("booking_id") @db.Uuid
  kind              PaymentKind
  amountPaise       BigInt         @map("amount_paise")
  state             PaymentState   @default(DUE)
  method            PaymentMethod?
  /// 'RAZORPAY' | 'CASH'
  provider          String?
  providerOrderId   String?        @unique @map("provider_order_id")
  providerPaymentId String?        @unique @map("provider_payment_id")
  providerRefundId  String?        @map("provider_refund_id")
  idempotencyKey    String?        @map("idempotency_key")
  failureCode       String?        @map("failure_code")
  /// When the Razorpay order was created (the customer opened the payment sheet).
  orderedAt         DateTime?      @map("ordered_at") @db.Timestamptz(6)
  /// When Razorpay was last asked about this payment (reconciliation).
  lastCheckedAt     DateTime?      @map("last_checked_at") @db.Timestamptz(6)
  /// When the payment was settled (paid, failed or refunded): Payment.at in the API.
  settledAt         DateTime?      @map("settled_at") @db.Timestamptz(6)
  /// Set when a refund was decided (cancellation before EN_ROUTE, unfulfilled, payment after cancellation).
  refundRequestedAt DateTime?      @map("refund_requested_at") @db.Timestamptz(6)
  /// Razorpay confirmed the refund (refund.processed webhook).
  refundProcessedAt DateTime?      @map("refund_processed_at") @db.Timestamptz(6)
  /// A coupon's discount (final bill only): amountPaise is what is paid after it.
  discountPaise     BigInt         @default(0) @map("discount_paise")
  couponCode        String?        @map("coupon_code")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, kind])
  @@map("payments")
}

/// Razorpay webhook deliveries, stored once per event id (deduplication). The payload keeps only ids, amounts and
/// statuses: Razorpay sends the payer's email, phone and payment details, which are dropped before storing.
model PaymentWebhookEvent {
  providerEventId String    @id @map("provider_event_id")
  event           String
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)

  @@map("payment_webhook_events")
}

// ---------- technicians ----------

enum Gender {
  M
  F

  @@map("gender")
}

enum Verification {
  PENDING
  APPROVED
  NEEDS_CORRECTION
  /// Not accepted (e.g. the identity check failed).
  REJECTED
  /// Was approved; access withdrawn. The QR verification page shows "not active".
  SUSPENDED

  @@map("verification")
}

enum TechPhotoStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("tech_photo_status")
}

enum PhoneType {
  SMARTPHONE
  KEYPAD
  NONE

  @@map("phone_type")
}

/// A technician's work profile (the name lives on users, shared with /me). Created by the first PUT /tech/profile.
model Technician {
  userId             String                                 @id @map("user_id") @db.Uuid
  gender             Gender
  experienceYears    Int                                    @map("experience_years")
  /// The district (or, on profiles from before the directory, the city as typed).
  city               String
  pincode            String                                 @db.Char(6)
  /// Localities they cover as one line (the `localities` joined, or free text on older profiles).
  areas              String
  /// Service area from India Post's directory (GET /places/...): state, district and the chosen localities; the PIN
  /// code belongs to one of them. Null / empty on profiles from before the directory.
  state              String?
  district           String?
  localities         String[]                               @default([])
  /// Vehicle and registration number, encrypted (customers see it only for their assigned technician).
  vehicleEnc         Bytes                                  @map("vehicle_enc")
  phoneType          PhoneType                              @default(SMARTPHONE) @map("phone_type")
  /// For technicians without a smartphone (coordinator-assisted jobs, step 13).
  coordinatorId      String?                                @map("coordinator_id") @db.Uuid
  verification       Verification
  correctionNoteEn   String?                                @map("correction_note_en")
  correctionNoteTe   String?                                @map("correction_note_te")
  online             Boolean                                @default(false)
  missedOffersInRow  Int                                    @default(0) @map("missed_offers_in_row")
  ratingAvg          Decimal?                               @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                                    @default(0) @map("rating_count")
  womenRated         Boolean                                @default(false) @map("women_rated")
  jobsDone           Int                                    @default(0) @map("jobs_done")
  /// Only while online or on a job; cleared when going offline.
  lastLocation       Unsupported("geography(Point, 4326)")? @map("last_location")
  lastLocationAt     DateTime?                              @map("last_location_at") @db.Timestamptz(6)
  lastAccuracyM      Int?                                   @map("last_accuracy_m")
  submittedAt        DateTime                               @map("submitted_at") @db.Timestamptz(6)
  verifiedAt         DateTime?                              @map("verified_at") @db.Timestamptz(6)
  /// Permanent Housefi Technician ID (N9-HF-T-XXXXXX): random, unique, never reused. Not a credential.
  techCode           String?                                @unique @map("tech_code")
  /// Legal name as on the identity document; locked after the first submission (corrections through support).
  legalNameEnc       Bytes?                                 @map("legal_name_enc")
  photoUploadId      String?                                @unique @map("photo_upload_id") @db.Uuid
  photoStatus        TechPhotoStatus                        @default(PENDING) @map("photo_status")
  /// QR verification token: SHA-256 for lookup, encrypted so the ID card shows the same link until it is re-issued.
  verifyTokenHash    Bytes?                                 @unique @map("verify_token_hash")
  verifyTokenEnc     Bytes?                                 @map("verify_token_enc")
  correctionKind     String?                                @map("correction_kind")
  correctionNote     String?                                @map("correction_note")
  correctionAt       DateTime?                              @map("correction_at") @db.Timestamptz(6)
  /// Aadhaar Secure QR (offline verification). Never the Aadhaar number: only its last 4 digits.
  aadhaarLast4       String?                                @map("aadhaar_last4") @db.Char(4)
  aadhaarYearOfBirth Int?                                   @map("aadhaar_year_of_birth") @db.SmallInt
  aadhaarGender      String?                                @map("aadhaar_gender") @db.Char(1)
  aadhaarNameMatch   Boolean?                               @map("aadhaar_name_match")
  /// The gender on the Aadhaar equals the profile's (true also when the Aadhaar says T or nothing: the profile offers M / F only).
  aadhaarGenderMatch Boolean?                               @map("aadhaar_gender_match")
  /// HMAC of name, birth date, gender and last 4 digits: one person, one technician account.
  aadhaarFingerprint Bytes?                                 @unique @map("aadhaar_fingerprint")
  aadhaarVerifiedAt  DateTime?                              @map("aadhaar_verified_at") @db.Timestamptz(6)
  /// Skill check (after the Aadhaar scan): the level they chose, and when they sent it (the review window starts
  /// from the later of this and submittedAt).
  skillLevel         SkillLevel?                            @map("skill_level")
  /// Skill Passport: the technician chose to show their career (trades and how they were proven, courses, jobs,
  /// rating, member since) on their public QR page. Off until they switch it on.
  passportPublic     Boolean                                @default(false) @map("passport_public")
  /// Apprentice mode: an experienced technician offers to teach apprentices (off until switched on).
  mentorOpen         Boolean                                @default(false) @map("mentor_open")
  skillSubmittedAt   DateTime?                              @map("skill_submitted_at") @db.Timestamptz(6)
  /// 4-digit PIN for accepting jobs by phone (keypad phones), stored only as an HMAC.
  ivrPinHash         Bytes?                                 @map("ivr_pin_hash")
  ivrConsentAt       DateTime?                              @map("ivr_consent_at") @db.Timestamptz(6)
  /// Agreed calling hours (IST), e.g. 8 to 20.
  callHoursStart     Int?                                   @map("call_hours_start") @db.SmallInt
  callHoursEnd       Int?                                   @map("call_hours_end") @db.SmallInt
  /// APP, IVR, COORDINATOR or SYSTEM: who last set online / offline.
  availabilitySource String?                                @map("availability_source")
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User                     @relation("TechnicianUser", fields: [userId], references: [id])
  photoUpload       Upload?                  @relation("TechnicianPhoto", fields: [photoUploadId], references: [id], onDelete: SetNull)
  coordinator       User?                    @relation("TechnicianCoordinator", fields: [coordinatorId], references: [id])
  skills            TechnicianSkill[]
  bookings          Booking[]                @relation("BookingTechnician")
  preferredIn       Booking[]                @relation("BookingPreferredTechnician")
  traineeIn         Booking[]                @relation("BookingTrainee")
  apprenticeLinks   ApprenticeLink[]         @relation("ApprenticeLinkApprentice")
  mentorLinks       ApprenticeLink[]         @relation("ApprenticeLinkMentor")
  offers            JobOffer[]
  ledger            EarningsLedger[]
  payouts           Payout[]
  ratings           Rating[]
  payoutAccount     TechnicianPayoutAccount?
  skillExams        SkillExamAttempt[]
  skillVideos       SkillVideo[]
  certificates      SkillCertificate[]
  courseEnrollments CourseEnrollment[]
  lessonProgress    LessonProgress[]
  courseQuizzes     CourseQuizAttempt[]
  coursePayments    CoursePayment[]

  @@index([pincode, online, verification])
  @@index([verification, submittedAt])
  @@map("technicians")
}

// ---------- apprentice mode ----------

enum ApprenticeLinkState {
  /// The apprentice asked; the mentor has not answered.
  REQUESTED
  ACTIVE
  DECLINED
  /// Either side ended it, or the apprentice passed the trade.
  ENDED

  @@map("apprentice_link_state")
}

/// An apprentice learning one trade with one mentor. At most one open (REQUESTED or ACTIVE) link per apprentice.
model ApprenticeLink {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  apprenticeId String              @map("apprentice_id") @db.Uuid
  mentorId     String              @map("mentor_id") @db.Uuid
  categoryId   CategoryId          @map("category_id")
  state        ApprenticeLinkState @default(REQUESTED)
  createdAt    DateTime            @map("created_at") @db.Timestamptz(6)
  respondedAt  DateTime?           @map("responded_at") @db.Timestamptz(6)
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz(6)

  apprentice Technician @relation("ApprenticeLinkApprentice", fields: [apprenticeId], references: [userId], onDelete: Cascade)
  mentor     Technician @relation("ApprenticeLinkMentor", fields: [mentorId], references: [userId], onDelete: Cascade)

  @@index([apprenticeId, state])
  @@index([mentorId, state])
  @@map("apprentice_links")
}

// ---------- skill check (after the Aadhaar scan) and certifications ----------

/// What the technician says best describes them; sets how hard the exam is.
enum SkillLevel {
  UNSKILLED
  SEMI_SKILLED
  SKILLED
  HIGHLY_SKILLED

  @@map("skill_level")
}

/// A person's decision on a work video or a certificate.
enum SkillReview {
  PENDING
  APPROVED
  REJECTED

  @@map("skill_review")
}

enum TradeVerifiedVia {
  /// Passed the skill exam for the trade.
  EXAM
  /// HQ watched a work video and approved it for the trade.
  VIDEO
  /// HQ verified the trade itself (e.g. a keypad-phone technician tested in person).
  HQ
  /// The trade was there before the skill check existed.
  EARLIER

  @@map("trade_verified_via")
}

enum SkillVideoSource {
  /// Recorded in the app (stops at 2 minutes).
  LIVE
  /// Chosen from the phone's gallery.
  UPLOAD
  /// The team's demo accounts only: no real video.
  SAMPLE

  @@map("skill_video_source")
}

enum CertificateKind {
  ITI
  SKILL_INDIA
  OTHER
  /// Earned in the app: a Housefi course completed (every lesson watched, quiz passed). Approved from the start.
  HOUSEFI_COURSE

  @@map("certificate_kind")
}

/// One skill exam paper for one trade: 3 MCQs, 3 diagram questions and 4 "choose the right part or tool" questions,
/// each section with its own time limit. The server keeps the time and the score; the app never sees the answers.
model SkillExamAttempt {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId  String     @map("technician_id") @db.Uuid
  categoryId    CategoryId @map("category_id")
  level         SkillLevel
  /// The paper, in order (question bank ids).
  questionIds   String[]   @map("question_ids")
  /// When each section was opened (ms since epoch, null until opened). Opening a section closes the one before.
  sectionStarts Json       @default("[]") @map("section_starts")
  /// Per question id: { option, firstAt, lastAt, changes } (ms; changes = how many times the answer was changed).
  answers       Json       @default("{}")
  /// How many times the technician left the app during the exam.
  leftApp       Int        @default(0) @map("left_app")
  startedAt     DateTime   @map("started_at") @db.Timestamptz(6)
  submittedAt   DateTime?  @map("submitted_at") @db.Timestamptz(6)
  /// Submitted by the time limit or by leaving the app too often, not by the technician.
  autoSubmitted Boolean    @default(false) @map("auto_submitted")
  correct       Int?
  basePoints    Int?       @map("base_points")
  bonusPoints   Int?       @map("bonus_points")
  passed        Boolean?

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@index([technicianId, categoryId, startedAt(sort: Desc)])
  @@map("skill_exam_attempts")
}

/// A 1-2 minute video of the technician at work: a person in HQ watches it and approves it for one or more trades.
model SkillVideo {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId String           @map("technician_id") @db.Uuid
  uploadId     String?          @unique @map("upload_id") @db.Uuid
  source       SkillVideoSource
  durationSec  Int?             @map("duration_sec")
  status       SkillReview      @default(PENDING)
  /// The trades HQ verified with this video.
  categoryIds  CategoryId[]     @default([]) @map("category_ids")
  reviewNote   String?          @map("review_note")
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime         @map("created_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)
  upload     Upload?    @relation("SkillVideoUpload", fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([technicianId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("skill_videos")
}

/// An ITI / Skill India / other certificate (image or PDF). Once HQ approves it, it shows as a certification on the
/// technician's profile and ID page.
model SkillCertificate {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId String          @map("technician_id") @db.Uuid
  kind         CertificateKind
  /// What it is, as the technician wrote it (e.g. "ITI Plumber 2019").
  title        String          @default("")
  uploadId     String?         @unique @map("upload_id") @db.Uuid
  /// The team's demo accounts only: no real file.
  sample       Boolean         @default(false)
  status       SkillReview     @default(PENDING)
  reviewNote   String?         @map("review_note")
  reviewedById String?         @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  createdAt    DateTime        @map("created_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)
  upload     Upload?    @relation("SkillCertificateUpload", fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([technicianId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("skill_certificates")
}

// ---------- courses (video lessons for technicians; the course texts and quizzes are in the code) ----------

/// How a technician got into a course.
enum CourseAccess {
  /// Basic and safety courses: free for everyone.
  FREE
  /// An advanced course, free with a rating of 3.8 or more.
  RATING
  /// An advanced course bought for 99 rupees.
  PAID

  @@map("course_access")
}

enum CoursePaymentState {
  /// The Razorpay order exists; the technician is paying.
  CREATED
  PAID
  FAILED

  @@map("course_payment_state")
}

/// HQ's video for one lesson (stored in the private bucket, played from a short-lived signed link).
model CourseLessonVideo {
  courseId     String   @map("course_id")
  lessonId     String   @map("lesson_id")
  videoKey     String   @map("video_key")
  contentType  String   @map("content_type")
  bytes        Int
  durationSec  Int      @map("duration_sec")
  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime @map("uploaded_at") @db.Timestamptz(6)

  @@id([courseId, lessonId])
  @@map("course_lesson_videos")
}

/// Whether HQ has opened a course to technicians (only possible once every lesson has its video).
model CoursePublication {
  courseId    String   @id @map("course_id")
  published   Boolean  @default(false)
  changedById String?  @map("changed_by_id") @db.Uuid
  changedAt   DateTime @map("changed_at") @db.Timestamptz(6)

  @@map("course_publications")
}

model CourseEnrollment {
  technicianId  String       @map("technician_id") @db.Uuid
  courseId      String       @map("course_id")
  access        CourseAccess
  startedAt     DateTime     @map("started_at") @db.Timestamptz(6)
  /// Every lesson watched and the quiz passed.
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(6)
  /// The certification it earned (skill_certificates, kind HOUSEFI_COURSE).
  certificateId String?      @unique @map("certificate_id") @db.Uuid

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@id([technicianId, courseId])
  @@index([courseId])
  @@map("course_enrollments")
}

/// How far a technician has watched one lesson. The server allows the position to move only as fast as real time
/// (no skipping to the end), and a lesson counts as watched near its end.
model LessonProgress {
  technicianId String    @map("technician_id") @db.Uuid
  courseId     String    @map("course_id")
  lessonId     String    @map("lesson_id")
  watchedSec   Int       @default(0) @map("watched_sec")
  lastReportAt DateTime  @map("last_report_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@id([technicianId, courseId, lessonId])
  @@map("lesson_progress")
}

model CourseQuizAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId String   @map("technician_id") @db.Uuid
  courseId     String   @map("course_id")
  /// Question number → option id as shown on that attempt.
  answers      Json
  correct      Int
  passed       Boolean
  submittedAt  DateTime @map("submitted_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@index([technicianId, courseId, submittedAt(sort: Desc)])
  @@map("course_quiz_attempts")
}

/// A 99-rupee purchase of an advanced course (Razorpay, or simulated for the team's demo accounts).
model CoursePayment {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId      String             @map("technician_id") @db.Uuid
  courseId          String             @map("course_id")
  amountPaise       BigInt             @map("amount_paise")
  state             CoursePaymentState @default(CREATED)
  /// 'RAZORPAY' | 'SIMULATED'
  provider          String
  providerOrderId   String             @unique @map("provider_order_id")
  providerPaymentId String?            @unique @map("provider_payment_id")
  method            PaymentMethod?
  createdAt         DateTime           @map("created_at") @db.Timestamptz(6)
  settledAt         DateTime?          @map("settled_at") @db.Timestamptz(6)
  lastCheckedAt     DateTime?          @map("last_checked_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@index([technicianId, courseId])
  @@index([state, createdAt])
  @@map("course_payments")
}

enum PayoutRail {
  BANK
  UPI

  @@map("payout_rail")
}

/// Where a technician's weekly payout goes (entered in the app: Profile -> Payout details). The account number, UPI ID
/// and holder name are encrypted; `hint` is the masked form shown in HQ and the app (e.g. XXXXXX1234 · SBIN0001234).
/// Deleted with the account.
model TechnicianPayoutAccount {
  technicianId     String     @id @map("technician_id") @db.Uuid
  rail             PayoutRail
  holderNameEnc    Bytes      @map("holder_name_enc")
  accountNumberEnc Bytes?     @map("account_number_enc")
  ifsc             String?    @db.Char(11)
  upiIdEnc         Bytes?     @map("upi_id_enc")
  hint             String
  updatedAt        DateTime   @map("updated_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@map("technician_payout_accounts")
}

model TechnicianSkill {
  technicianId String            @map("technician_id") @db.Uuid
  categoryId   CategoryId        @map("category_id")
  /// When this trade was verified (a passed skill exam, a work video HQ approved, or HQ itself). Job offers go only
  /// to verified trades. Trades from before the skill check were marked verified (EARLIER).
  verifiedAt   DateTime?         @map("verified_at") @db.Timestamptz(6)
  verifiedVia  TradeVerifiedVia? @map("verified_via")

  technician Technician @relation(fields: [technicianId], references: [userId], onDelete: Cascade)

  @@id([technicianId, categoryId])
  @@map("technician_skills")
}

// ---------- audit ----------

/// Who did what, when, before and after: every verification decision now, every privileged action later.
model AuditLog {
  id        BigInt    @id @default(autoincrement())
  actorType ActorType @map("actor_type")
  actorId   String?   @map("actor_id") @db.Uuid
  /// 'tech.approve', 'tech.request_correction', ...
  action    String
  entity    String
  entityId  String    @map("entity_id")
  before    Json?
  after     Json?
  ip        String?   @db.Inet
  requestId String?   @map("request_id")
  at        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([entity, entityId, at])
  @@map("audit_log")
}

// ---------- dispatch ----------

enum OfferState {
  OPEN
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN

  @@map("offer_state")
}

enum OfferChannel {
  APP
  SMS
  IVR
  COORDINATOR

  @@map("offer_channel")
}

enum OfferRejectReason {
  TOO_FAR
  BUSY
  NOT_MY_SKILL
  OTHER

  @@map("offer_reject")
}

/// A job offered to one technician at a time. At most one OPEN offer per booking and per technician (partial
/// unique indexes in the migration).
model JobOffer {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String             @map("booking_id") @db.Uuid
  technicianId String             @map("technician_id") @db.Uuid
  state        OfferState         @default(OPEN)
  channel      OfferChannel       @default(APP)
  rejectReason OfferRejectReason? @map("reject_reason")
  /// Straight-line distance from the technician's last location, when both points are known.
  distanceM    Int?               @map("distance_m")
  createdAt    DateTime           @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime           @map("expires_at") @db.Timestamptz(6)
  respondedAt  DateTime?          @map("responded_at") @db.Timestamptz(6)

  booking    Booking    @relation(fields: [bookingId], references: [id])
  technician Technician @relation(fields: [technicianId], references: [userId])

  callAttempts OfferCallAttempt[]

  @@index([bookingId, technicianId])
  @@index([technicianId, state, respondedAt])
  @@index([state, expiresAt])
  @@map("job_offers")
}

/// Which PIN codes neighbour which (dispatch v1 matches the booking's PIN and its neighbours). Store both directions.
model ServiceAreaPincode {
  pincode     String @db.Char(6)
  nearPincode String @map("near_pincode") @db.Char(6)

  @@id([pincode, nearPincode])
  @@map("service_area_pincodes")
}

// ---------- quotes ----------

enum QuoteWhich {
  MAIN
  EXTRA

  @@map("quote_which")
}

enum QuoteLineKind {
  LABOUR
  MATERIAL

  @@map("quote_line_kind")
}

enum QuoteReview {
  CHECKING
  FAIR
  UNDER_REVIEW
  CLEARED

  @@map("quote_review")
}

enum QuoteDecision {
  PENDING
  APPROVED
  REVISION_REQUESTED
  REJECTED

  @@map("quote_decision")
}

/// The repair quote (MAIN) or extra work found during the repair (EXTRA). Each revision is a new version; old
/// versions are kept (superseded) for audit.
model Quote {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId       String        @map("booking_id") @db.Uuid
  which           QuoteWhich
  version         Int
  /// What the technician found (their own words).
  diagnosis       String
  labourPaise     BigInt        @map("labour_paise")
  materialPaise   BigInt        @map("material_paise")
  totalPaise      BigInt        @map("total_paise")
  review          QuoteReview   @default(CHECKING)
  /// The service's usual range at the time of the quote (price check).
  typicalMinPaise BigInt        @map("typical_min_paise")
  typicalMaxPaise BigInt        @map("typical_max_paise")
  decision        QuoteDecision @default(PENDING)
  createdBy       String        @map("created_by") @db.Uuid
  /// Null while reviews are cleared automatically (no reviewers yet).
  reviewedBy      String?       @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt       DateTime      @map("created_at") @db.Timestamptz(6)
  decidedAt       DateTime?     @map("decided_at") @db.Timestamptz(6)
  superseded      Boolean       @default(false)

  booking Booking     @relation(fields: [bookingId], references: [id])
  lines   QuoteLine[]

  @@unique([bookingId, which, version])
  @@index([review, createdAt])
  @@map("quotes")
}

model QuoteLine {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId   String        @map("quote_id") @db.Uuid
  kind      QuoteLineKind
  name      String
  qty       Int
  unitPaise BigInt        @map("unit_paise")
  sort      Int
  /// The part from the price list this line is (materials), when picked from it.
  partId    String?       @map("part_id") @db.Uuid

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part  Part? @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([quoteId, sort])
  @@map("quote_lines")
}

// ---------- support ----------

enum TicketState {
  OPEN
  IN_PROGRESS
  RESOLVED

  @@map("ticket_state")
}

enum TicketPriority {
  NORMAL
  HIGH
  URGENT

  @@map("ticket_priority")
}

/// Problems for the support team: technician reports, locked start codes, customer SOS / payment tickets and call-back
/// requests. Handled with `npm run support` until the admin portal exists.
model SupportTicket {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId  String?        @map("booking_id") @db.Uuid
  raisedBy   String         @map("raised_by") @db.Uuid
  /// TechIssue values, 'START_CODE_LOCKED', and from POST /support/*: 'UNSAFE', 'PAYMENT_PROBLEM', 'OTHER', 'CALLBACK'.
  kind       String
  note       String         @default("")
  state      TicketState    @default(OPEN)
  priority   TicketPriority @default(NORMAL)
  createdAt  DateTime       @map("created_at") @db.Timestamptz(6)
  resolvedAt DateTime?      @map("resolved_at") @db.Timestamptz(6)
  /// Who resolved it (null for the command line; who ran it is in audit_log) and what was done.
  resolvedBy String?        @map("resolved_by") @db.Uuid
  resolution String?
  /// Where the person was when they pressed SOS (or reported a problem): the phone's position, if it gave one.
  lat        Float?
  lng        Float?
  accuracyM  Int?           @map("accuracy_m")
  locatedAt  DateTime?      @map("located_at") @db.Timestamptz(6)
  /// The super admin who took it ("I'm on it") in the portal, and when.
  handledBy  String?        @map("handled_by") @db.Uuid
  handledAt  DateTime?      @map("handled_at") @db.Timestamptz(6)

  booking Booking? @relation(fields: [bookingId], references: [id])
  raiser  User     @relation(fields: [raisedBy], references: [id])

  @@index([state, priority, createdAt])
  @@index([bookingId])
  @@map("support_tickets")
}

// ---------- earnings ----------

enum LedgerType {
  VISIT_SHARE
  LABOUR_SHARE
  MATERIAL_REIMBURSE
  /// Apprentice mode: an apprentice helped on the job (paid by Housefi, not by the customer or the technician).
  APPRENTICE_SHARE
  CASH_COLLECTED
  ADJUSTMENT
  PAYOUT

  @@map("ledger_type")
}

enum PayoutState {
  PENDING
  PROCESSING
  PAID
  FAILED

  @@map("payout_state")
}

/// Append-only money owed to (credits, positive) or by (debits, negative) a technician. Never updated except to link
/// an entry to the payout that settles it. Balances are always sums, never a stored running number.
model EarningsLedger {
  id           BigInt     @id @default(autoincrement())
  technicianId String     @map("technician_id") @db.Uuid
  bookingId    String?    @map("booking_id") @db.Uuid
  type         LedgerType
  amountPaise  BigInt     @map("amount_paise")
  payoutId     String?    @map("payout_id") @db.Uuid
  createdAt    DateTime   @map("created_at") @db.Timestamptz(6)

  technician Technician @relation(fields: [technicianId], references: [userId])
  booking    Booking?   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payout     Payout?    @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([technicianId, createdAt(sort: Desc)])
  @@index([technicianId, payoutId])
  @@map("earnings_ledger")
}

/// A weekly settlement: everything a technician earned minus cash they collected, up to the period end.
model Payout {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  technicianId String      @map("technician_id") @db.Uuid
  periodStart  DateTime    @map("period_start") @db.Date
  periodEnd    DateTime    @map("period_end") @db.Date
  amountPaise  BigInt      @map("amount_paise")
  state        PayoutState @default(PENDING)
  /// Bank / UPI transfer reference, entered when marked paid (RazorpayX payout id later).
  providerRef  String?     @map("provider_ref")
  createdAt    DateTime    @map("created_at") @db.Timestamptz(6)
  paidAt       DateTime?   @map("paid_at") @db.Timestamptz(6)

  technician Technician       @relation(fields: [technicianId], references: [userId])
  entries    EarningsLedger[]

  @@index([state, createdAt])
  @@map("payouts")
}

// ---------- notifications ----------

enum NotificationKind {
  TECH_ASSIGNED
  TECH_ON_THE_WAY
  TECH_ARRIVED
  QUOTE_READY
  EXTRA_QUOTE
  PAYMENT_DUE
  BOOKING_COMPLETED
  BOOKING_CANCELLED
  NO_TECHNICIAN
  JOB_OFFER
  QUOTE_APPROVED
  QUOTE_REVISION
  QUOTE_DECLINED
  EXTRA_APPROVED
  EXTRA_DECLINED
  PAYMENT_RECEIVED
  JOB_CANCELLED
  PROFILE_APPROVED
  PROFILE_NEEDS_CORRECTION
  PAY_REMINDER
  BOOKING_REMINDER
  JOB_REMINDER
  /// The evening before a scheduled visit (19:00 IST): to the customer and the technician.
  BOOKING_TOMORROW
  JOB_TOMORROW
  /// 07:30 IST: the technician's scheduled jobs for the day.
  JOB_DAY_PLAN
  /// A chat message from the other side (the text is never in the notification).
  CHAT_MESSAGE
  QUOTE_REMINDER
  RATE_REMINDER
  PROFILE_SUSPENDED
  PROFILE_REINSTATED
  PROFILE_REJECTED
  /// Housefi HQ answered in the person's support conversation (the text is never in the notification).
  SUPPORT_REPLY
  /// A message from Housefi HQ to all customers or all technicians (params: title, body, titleTe, bodyTe).
  ANNOUNCEMENT
  /// Apprentice mode: to the mentor (someone asks to learn), to the apprentice (accepted; added to a job; taken off one).
  APPRENTICE_REQUEST
  APPRENTICE_ACCEPTED
  TRAINEE_JOB
  TRAINEE_REMOVED

  @@map("notification_kind")
}

enum PushState {
  /// Waiting for the delivery worker.
  PENDING
  /// Claimed by a worker (reclaimed if it stays here too long).
  SENDING
  /// Accepted by the push service for at least one device.
  SENT
  /// Not sent: no live device, or too old to be useful (an expired offer).
  SKIPPED
  /// The push service kept failing.
  FAILED

  @@map("push_state")
}

enum DevicePlatform {
  ios
  android
  web

  @@map("device_platform")
}

/// A phone that receives push notifications for one account, from one sign-in session.
model Device {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  pushToken  String         @unique @map("push_token")
  platform   DevicePlatform
  /// The refresh-token family it was registered from: pushes stop when that session ends (logout, revoked, expired).
  sessionId  String         @map("session_id") @db.Uuid
  lastSeenAt DateTime       @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("devices")
}

/// The in-app inbox, and the outbox for push: rows are written in the transaction of the change they announce.
model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Insertion order: breaks ties between notifications written in the same millisecond.
  seq           BigInt           @default(autoincrement())
  userId        String           @map("user_id") @db.Uuid
  kind          NotificationKind
  bookingId     String?          @map("booking_id") @db.Uuid
  /// Values for the text (codes, amounts, ids): never names, phone numbers or addresses.
  params        Json             @default("{}")
  readAt        DateTime?        @map("read_at") @db.Timestamptz(6)
  pushState     PushState        @default(PENDING) @map("push_state")
  pushAttempts  Int              @default(0) @map("push_attempts")
  pushClaimedAt DateTime?        @map("push_claimed_at") @db.Timestamptz(6)
  pushedAt      DateTime?        @map("pushed_at") @db.Timestamptz(6)
  /// SMS fallback (keypad phones) comes with two-way SMS later.
  smsAt         DateTime?        @map("sms_at") @db.Timestamptz(6)
  createdAt     DateTime         @map("created_at") @db.Timestamptz(6)

  user    User     @relation(fields: [userId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc), seq(sort: Desc)])
  @@map("notifications")
}

// ---------- ratings ----------

/// The customer's rating of a finished visit (COMPLETED or CLOSED_NO_REPAIR), once per booking.
model Rating {
  bookingId    String   @id @map("booking_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  technicianId String?  @map("technician_id") @db.Uuid
  satisfied    Boolean
  stars        Int      @db.SmallInt
  /// From: onTime, polite, clean, fair, explained, fixed.
  tags         String[] @default([])
  comment      String   @default("")
  /// Self-declared "I'm a woman": only feeds the technician's women-rated badge. Never returned to anyone.
  byWoman      Boolean  @default(false) @map("by_woman")
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)

  booking    Booking     @relation(fields: [bookingId], references: [id])
  customer   User        @relation(fields: [customerId], references: [id])
  technician Technician? @relation(fields: [technicianId], references: [userId])

  @@index([technicianId, createdAt(sort: Desc)])
  @@map("ratings")
}

// ---------- uploads ----------

enum UploadKind {
  PHOTO
  AUDIO
  /// A technician's work video for the skill check (mp4 / mov, up to 2 minutes).
  VIDEO
  /// A certificate: an image or a PDF.
  DOCUMENT

  @@map("upload_kind")
}

enum UploadStage {
  PROBLEM
  INSPECTION
  COMPLETION
  /// A technician's registration photo (ID card).
  PROFILE
  /// A photo sent in the chat between the customer and the technician (cleared with the chat).
  CHAT
  /// A technician's skill-check file: work video or certificate.
  SKILL

  @@map("upload_stage")
}

enum UploadState {
  /// A signed PUT URL was handed out; the file may or may not be in the bucket yet.
  PENDING
  /// The file was checked (type, size, length) and, for photos, its location data removed.
  READY
  /// The file failed the checks; the object is deleted.
  REJECTED

  @@map("upload_state")
}

/// A photo or voice note in the private uploads bucket. The object key carries no personal data (u/<id>).
model Upload {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId      String       @map("owner_id") @db.Uuid
  kind         UploadKind
  stage        UploadStage?
  contentType  String       @map("content_type")
  /// The exact size the signed URL allows (S3 refuses any other Content-Length).
  bytes        Int
  state        UploadState  @default(PENDING)
  /// Seconds, for voice notes (from the file).
  durationSec  Int?         @map("duration_sec")
  /// Set once the upload is part of a booking; it can never move to another one.
  bookingId    String?      @map("booking_id") @db.Uuid
  rejectReason String?      @map("reject_reason")
  createdAt    DateTime     @map("created_at") @db.Timestamptz(6)
  /// The signed PUT URL stops working at this time.
  urlExpiresAt DateTime     @map("url_expires_at") @db.Timestamptz(6)
  verifiedAt   DateTime?    @map("verified_at") @db.Timestamptz(6)

  owner            User              @relation(fields: [ownerId], references: [id])
  booking          Booking?          @relation(fields: [bookingId], references: [id])
  /// Set when this is a technician's registration photo (kept while it is in use).
  profileOf        Technician?       @relation("TechnicianPhoto")
  chatMessage      ChatMessage?
  /// Kept while it is a technician's work video or certificate.
  skillVideo       SkillVideo?       @relation("SkillVideoUpload")
  skillCertificate SkillCertificate? @relation("SkillCertificateUpload")

  @@index([ownerId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([state, createdAt])
  @@map("uploads")
}

// ---------- telephony (docs/TELEPHONY.md) ----------

enum CallState {
  REQUESTED
  RINGING
  ANSWERED
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED

  @@map("call_state")
}

enum KeypadResult {
  ACCEPT
  REJECT
  NONE
  INVALID
  PIN_FAILED
  TOO_LATE

  @@map("keypad_result")
}

/// One phone call made for a job offer. The call state never moves the offer by itself.
model OfferCallAttempt {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offerId        String        @map("offer_id") @db.Uuid
  provider       String
  providerCallId String?       @unique @map("provider_call_id")
  state          CallState     @default(REQUESTED)
  keypadResult   KeypadResult? @map("keypad_result")
  pinAttempts    Int           @default(0) @map("pin_attempts") @db.SmallInt
  requestedAt    DateTime      @map("requested_at") @db.Timestamptz(6)
  answeredAt     DateTime?     @map("answered_at") @db.Timestamptz(6)
  endedAt        DateTime?     @map("ended_at") @db.Timestamptz(6)
  durationS      Int?          @map("duration_s")
  failureReason  String?       @map("failure_reason")

  offer JobOffer @relation(fields: [offerId], references: [id])

  @@index([offerId], map: "offer_call_attempts_offer_idx")
  @@map("offer_call_attempts")
}

/// Bookings waiting for a coordinator to assign them.
model DispatchQueueEntry {
  bookingId  String    @id @map("booking_id") @db.Uuid
  reason     String
  enteredAt  DateTime  @map("entered_at") @db.Timestamptz(6)
  claimedBy  String?   @map("claimed_by") @db.Uuid
  claimedAt  DateTime? @map("claimed_at") @db.Timestamptz(6)
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("dispatch_queue")
}

/// Masked calls: who may call whom through the Housefi number, for one booking, for a short time.
model CallGrant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  callerId  String   @map("caller_id") @db.Uuid
  calleeId  String   @map("callee_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([callerId, expiresAt(sort: Desc)], map: "call_grants_caller_idx")
  @@map("call_grants")
}

/// Provider callbacks already handled (providers retry).
model TelephonyEvent {
  eventId    String   @id @map("event_id")
  receivedAt DateTime @map("received_at") @db.Timestamptz(6)

  @@map("telephony_events")
}

// ---------- chat ----------

/// A message between the customer and the assigned technician: open from assignment until the job is done, then
/// read-only; either side can clear it after that, and it is cleared 24 h after the job anyway. Text encrypted.
model ChatMessage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Insertion order (ties within a millisecond).
  seq        BigInt   @default(autoincrement())
  bookingId  String   @map("booking_id") @db.Uuid
  senderId   String   @map("sender_id") @db.Uuid
  senderRole UserRole @map("sender_role")
  /// The text (encrypted, 'chat_messages.body'); empty for a photo without words.
  bodyEnc    Bytes    @map("body_enc")
  uploadId   String?  @unique @map("upload_id") @db.Uuid
  createdAt  DateTime @map("created_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  upload  Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)

  @@index([bookingId, seq])
  @@map("chat_messages")
}

// ---------- super admin portal ----------

/// A super admin (the founders). Created only by the command line (npm run admin -- create); there is no sign-up.
model AdminUser {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// The official username, e.g. "hq.sujal.k7m2" (lower case).
  username          String    @unique
  displayName       String    @map("display_name")
  /// scrypt: "scrypt$N$r$p$saltB64$hashB64". The password itself is never stored or logged.
  passwordHash      String    @map("password_hash")
  /// The admin's phone for account recovery: encrypted ('admin_users.phone'), and an HMAC for comparing.
  phoneEnc          Bytes     @map("phone_enc")
  phoneHash         Bytes     @map("phone_hash")
  failedLogins      Int       @default(0) @map("failed_logins")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime  @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt       DateTime? @map("last_login_at") @db.Timestamptz(6)
  disabledAt        DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt         DateTime  @map("created_at") @db.Timestamptz(6)

  passkeys      AdminPasskey[]
  sessions      AdminSession[]
  recoveries    AdminRecovery[]
  guideMessages AdminGuideMessage[]
  actions       AdminAction[]
  gameScores    AdminGameScore[]

  @@map("admin_users")
}

/// A passkey (Windows Hello face / fingerprint / PIN) registered by an admin after their first password login.
model AdminPasskey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId      String    @map("admin_id") @db.Uuid
  /// WebAuthn credential id, base64url.
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String[]
  deviceName   String    @map("device_name")
  createdAt    DateTime  @map("created_at") @db.Timestamptz(6)
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(6)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_passkeys")
}

enum AdminSessionStage {
  /// Password right: the passkey step is next (a few minutes at most).
  PASSWORD_OK
  /// Password and passkey: signed in.
  VERIFIED

  @@map("admin_session_stage")
}

/// A sign-in to the portal: a random token in an HttpOnly cookie, stored here only as its SHA-256.
model AdminSession {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String            @map("admin_id") @db.Uuid
  tokenHash  Bytes             @unique @map("token_hash")
  stage      AdminSessionStage
  /// The WebAuthn challenge being answered (passkey step), base64url.
  challenge  String?
  ip         String
  userAgent  String            @map("user_agent")
  createdAt  DateTime          @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime          @map("last_seen_at") @db.Timestamptz(6)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime?         @map("revoked_at") @db.Timestamptz(6)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_sessions")
}

/// "Forgot password", like Apple's account recovery: phone and one-time code, then a wait of 2 to 24 hours that no one
/// can shorten; a normal sign-in by the owner meanwhile cancels it. Then the same browser may set a new password.
model AdminRecovery {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId     String    @map("admin_id") @db.Uuid
  /// SHA-256 of the token kept in that browser's cookie.
  tokenHash   Bytes     @unique @map("token_hash")
  ip          String
  userAgent   String    @map("user_agent")
  createdAt   DateTime  @map("created_at") @db.Timestamptz(6)
  /// From when the new password may be set.
  readyAt     DateTime  @map("ready_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@map("admin_recoveries")
}

// ---------- live support (customer care chat with Housefi HQ) ----------

enum SupportThreadState {
  OPEN
  CLOSED

  @@map("support_thread_state")
}

/// A conversation with Housefi HQ, started from the app's assistant after it asked what it is about (the intake).
/// One open conversation per person; closed by HQ, and deletable from the portal.
model SupportThread {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String             @map("user_id") @db.Uuid
  role          UserRole
  /// The booking it is about, if any (the person's own).
  bookingId     String?            @map("booking_id") @db.Uuid
  /// BOOKING | PAYMENT | TECHNICIAN | APP | OTHER (from the intake).
  topic         String
  state         SupportThreadState @default(OPEN)
  unreadForHq   Int                @default(0) @map("unread_for_hq")
  unreadForUser Int                @default(0) @map("unread_for_user")
  createdAt     DateTime           @map("created_at") @db.Timestamptz(6)
  lastMessageAt DateTime           @map("last_message_at") @db.Timestamptz(6)
  closedAt      DateTime?          @map("closed_at") @db.Timestamptz(6)
  /// The super admin who closed it.
  closedBy      String?            @map("closed_by") @db.Uuid

  user     User             @relation(fields: [userId], references: [id])
  messages SupportMessage[]

  @@index([state, lastMessageAt(sort: Desc)])
  @@index([userId, state])
  @@map("support_threads")
}

/// One message in a support conversation: from the person (USER), from a super admin (HQ), or the intake (SYSTEM).
model SupportMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq       BigInt   @default(autoincrement())
  threadId  String   @map("thread_id") @db.Uuid
  from      String
  /// The super admin who wrote it (HQ messages).
  adminId   String?  @map("admin_id") @db.Uuid
  /// The text, encrypted ('support_messages.body').
  bodyEnc   Bytes    @map("body_enc")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, seq])
  @@map("support_messages")
}

// ---------- Housefi HQ: the guide (Sarathi), its proposed actions, and the arcade ----------

/// A conversation turn with Sarathi, the portal's guide: the admin's words or the guide's answer, encrypted
/// ('admin_guide_messages.body'). Kept 7 days, and the admin can clear it.
model AdminGuideMessage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq       BigInt   @default(autoincrement())
  adminId   String   @map("admin_id") @db.Uuid
  /// 'admin' | 'guide'
  role      String
  bodyEnc   Bytes    @map("body_enc")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, seq])
  @@map("admin_guide_messages")
}

enum AdminActionState {
  PROPOSED
  DONE
  REJECTED
  FAILED
  EXPIRED

  @@map("admin_action_state")
}

/// Something Sarathi proposed to do. The guide never acts: only the admin who asked can approve it, in the portal,
/// with the checks its risk needs (LOW: a click; HIGH: also typing the confirmation; CRITICAL: typing it twice and
/// Windows Hello). The exact arguments are stored here and shown before approval; nothing else can be run.
model AdminAction {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId       String           @map("admin_id") @db.Uuid
  tool          String
  args          Json
  /// What it will do, in plain words (shown on the approval card).
  summary       String
  /// LOW | HIGH | CRITICAL
  risk          String
  /// The words to type (HIGH and CRITICAL), e.g. "DELETE Ravi Kumar".
  confirmPhrase String?          @map("confirm_phrase")
  state         AdminActionState @default(PROPOSED)
  createdAt     DateTime         @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime         @map("expires_at") @db.Timestamptz(6)
  decidedAt     DateTime?        @map("decided_at") @db.Timestamptz(6)
  /// What happened (a short note; never personal data).
  result        String?

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, state])
  @@map("admin_actions")
}

/// HQ Arcade high scores (the founders' leaderboard).
model AdminGameScore {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  game      String
  score     Int
  /// e.g. the level reached.
  detail    String   @default("")
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  admin AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([game, score(sort: Desc)])
  @@map("admin_game_scores")
}

// ---------- growth: coupons, invoices, announcements, the parts price list ----------

enum CouponKind {
  /// value = rupees off
  FLAT
  /// value = percent off (maxDiscountPaise caps it)
  PERCENT

  @@map("coupon_kind")
}

/// A discount code made in Housefi HQ, applied by the customer to the final bill. Housefi pays the discount: the
/// technician's earnings come from the approved quote, unchanged.
model Coupon {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Upper case, e.g. FIRST50.
  code             String     @unique
  description      String     @default("")
  kind             CouponKind
  value            Int
  maxDiscountPaise BigInt?    @map("max_discount_paise")
  /// The bill must be at least this (before the discount).
  minBillPaise     BigInt     @default(0) @map("min_bill_paise")
  validFrom        DateTime?  @map("valid_from") @db.Timestamptz(6)
  validTo          DateTime?  @map("valid_to") @db.Timestamptz(6)
  /// All customers together; null = no limit.
  maxUses          Int?       @map("max_uses")
  perCustomer      Int        @default(1) @map("per_customer")
  /// Only for a customer's first completed booking.
  firstBookingOnly Boolean    @default(false) @map("first_booking_only")
  active           Boolean    @default(true)
  /// The super admin who made it.
  createdBy        String     @map("created_by") @db.Uuid
  createdAt        DateTime   @map("created_at") @db.Timestamptz(6)

  redemptions CouponRedemption[]

  @@map("coupons")
}

/// A coupon on one booking's final bill (removed again if the customer takes it off before paying).
model CouponRedemption {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  bookingId     String   @unique @map("booking_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  discountPaise BigInt   @map("discount_paise")
  createdAt     DateTime @map("created_at") @db.Timestamptz(6)

  coupon  Coupon  @relation(fields: [couponId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([couponId])
  @@index([customerId])
  @@map("coupon_redemptions")
}

/// A tax invoice for a completed booking: numbered in order (HFI/2026-27/000123), issued once, never renumbered.
model Invoice {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seq       BigInt   @unique @default(autoincrement())
  number    String   @unique
  bookingId String   @unique @map("booking_id") @db.Uuid
  issuedAt  DateTime @map("issued_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("invoices")
}

/// A message from Housefi HQ to customers or technicians (as a notification and push).
model Announcement {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// CUSTOMERS | TECHNICIANS | ALL | DEMO (team demo accounts only, to test first)
  audience   String
  titleEn    String   @map("title_en")
  bodyEn     String   @map("body_en")
  titleTe    String   @map("title_te")
  bodyTe     String   @map("body_te")
  recipients Int
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@map("announcements")
}

/// The parts price list: standard prices for common parts, per category. Quotes using listed parts at their price
/// pass the price check more easily.
model Part {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId CategoryId @map("category_id")
  /// Optional: a part for one service only.
  serviceId  String?    @map("service_id")
  nameEn     String     @map("name_en")
  nameTe     String     @map("name_te")
  /// 'piece', 'metre', 'litre', 'kg' ...
  unit       String     @default("piece")
  pricePaise BigInt     @map("price_paise")
  active     Boolean    @default(true)
  sort       Int        @default(0)
  updatedAt  DateTime   @map("updated_at") @db.Timestamptz(6)

  service Service?    @relation(fields: [serviceId], references: [id])
  lines   QuoteLine[]

  @@index([categoryId, active, sort])
  @@map("parts")
}
