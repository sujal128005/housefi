{
  "expo": {
    "name": "Housefi",
    "slug": "housefi",
    "scheme": "housefi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.housefi.mobile"
    },
    "android": {
      "package": "app.housefi.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0A3CFD",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Housefi uses your location to fill in your address so the technician can find you."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Housefi lets you add photos of the problem so the technician knows what to bring.",
          "cameraPermission": "Housefi lets you take a photo of the problem so the technician knows what to bring."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F5"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#FAF9F5"
  }
}
