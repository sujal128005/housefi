// Housefi database. Models are added feature by feature (auth, catalog, bookings, ...), each with a committed
// migration, following docs/schema.sql. Money is stored in paise (BigInt); the API speaks whole rupees.
// Columns ending in Enc hold AES-256-GCM envelope ciphertext (src/common/crypto); Hash columns hold HMAC-SHA256.
// PostGIS: geography(Point, 4326) columns are Unsupported for Prisma and are read / written with raw SQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- enums (mirror the app's src/domain/types.ts) ----------

enum UserRole {
  CUSTOMER
  TECHNICIAN
  COORDINATOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED

  @@map("user_status")
}

enum Locale {
  en
  te

  @@map("locale")
}

// ---------- identity ----------

/// One row per account. The same phone may hold one CUSTOMER and one TECHNICIAN account (separate users).
model User {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role      UserRole
  phoneEnc  Bytes      @map("phone_enc")
  /// HMAC(phone) for lookup; the phone itself is only stored encrypted.
  phoneHash Bytes      @map("phone_hash")
  nameEnc   Bytes?     @map("name_enc")
  locale    Locale     @default(en)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(6)

  refreshTokens RefreshToken[]
  addresses     Address[]
  bookings      Booking[]

  @@unique([role, phoneHash])
  @@map("users")
}

/// One SMS code. The code is stored only as HMAC(pepper, challengeId:code).
model OtpChallenge {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneHash  Bytes     @map("phone_hash")
  /// Encrypted phone, needed to create the account on success (not in docs/schema.sql; see docs/API-NOTES.md).
  phoneEnc   Bytes     @map("phone_enc")
  role       UserRole
  codeHash   Bytes     @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  ip         String?   @db.Inet
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneHash, createdAt(sort: Desc)])
  @@map("otp_challenges")
}

/// Refresh tokens, stored only as HMAC(pepper, token). Each sign-in starts a family; every refresh replaces the
/// token with a new one in the same family. Presenting a used or revoked token revokes the whole family.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  device    String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- catalog (seeded from the app's src/data/catalog.ts: npm run catalog:import, then npm run db:seed) ----------

enum CategoryId {
  PLUMBING
  ELECTRICAL
  AC
  APPLIANCE
  CLEANING
  CARPENTRY

  @@map("category_id")
}

model Category {
  id        CategoryId @id
  nameEn    String     @map("name_en")
  nameTe    String     @map("name_te")
  taglineEn String     @map("tagline_en")
  taglineTe String     @map("tagline_te")
  /// Which artwork the app shows (tap, bulb, snowflake, tv, sponge, saw).
  art       String
  /// Background tint name used by the app (not in docs/schema.sql; the API's Category requires it).
  wash      String
  sort      Int

  services Service[]

  @@map("categories")
}

model Service {
  id                    String     @id
  categoryId            CategoryId @map("category_id")
  nameEn                String     @map("name_en")
  nameTe                String     @map("name_te")
  descriptionEn         String     @map("description_en")
  descriptionTe         String     @map("description_te")
  visitFeePaise         BigInt     @default(4900) @map("visit_fee_paise")
  /// Typical minimum repair (labour + materials); the price check's lower bound.
  repairFromPaise       BigInt     @map("repair_from_paise")
  /// Typical maximum repair; quotes above 1.5x this go to review.
  repairTypicalMaxPaise BigInt     @map("repair_typical_max_paise")
  durationMin           Int        @map("duration_min")
  durationMax           Int        @map("duration_max")
  /// Shown on the service page. Demo values from the app catalog until real ratings exist.
  rating                Float
  reviews               Int
  keywords              String[]   @default([])
  popular               Boolean    @default(false)
  /// Services removed from the catalog are deactivated, never deleted (bookings keep referring to them).
  active                Boolean    @default(true)
  sort                  Int

  category Category       @relation(fields: [categoryId], references: [id])
  issues   ServiceIssue[]
  bookings Booking[]

  @@index([categoryId, sort])
  @@map("services")
}

model ServiceIssue {
  id        String @id
  serviceId String @map("service_id")
  nameEn    String @map("name_en")
  nameTe    String @map("name_te")
  sort      Int

  service Service @relation(fields: [serviceId], references: [id])

  @@index([serviceId, sort])
  @@map("service_issues")
}

// ---------- customers ----------

enum AddressLabel {
  HOME
  WORK
  OTHER

  @@map("address_label")
}

/// Saved addresses. House, street and landmark are encrypted; city, PIN and the coarse locality stay readable because
/// offers show the area to technicians before they accept. Deleting wipes the personal fields (soft delete).
model Address {
  id          String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                                 @map("user_id") @db.Uuid
  label       AddressLabel
  houseEnc    Bytes                                  @map("house_enc")
  streetEnc   Bytes                                  @map("street_enc")
  landmarkEnc Bytes?                                 @map("landmark_enc")
  /// Coarse area shown in job offers ("Banjara Hills"); derived from the street until the app sends one.
  locality    String
  city        String
  pincode     String                                 @db.Char(6)
  /// From the phone's GPS when the customer used "my current location".
  location    Unsupported("geography(Point, 4326)")?
  createdAt   DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?                              @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ---------- visit slots ----------

/// Per-area capacity overrides: bookings allowed per 2-hour window for one category in one PIN area.
/// Areas without a row use SLOT_CAPACITY_PER_WINDOW.
model SlotCapacity {
  categoryId   CategoryId @map("category_id")
  pincode      String     @db.Char(6)
  maxPerWindow Int        @map("max_per_window")

  @@id([categoryId, pincode])
  @@map("slot_capacities")
}

// ---------- bookings ----------

enum BookingMode {
  INSTANT
  SCHEDULED

  @@map("booking_mode")
}

enum BookingStatus {
  AWAITING_PAYMENT
  PAYMENT_PENDING
  MATCHING
  MATCHING_DELAYED
  UNFULFILLED
  ASSIGNED
  EN_ROUTE
  ARRIVED
  INSPECTING
  QUOTE_SHARED
  IN_PROGRESS
  EXTRA_WORK
  PAYMENT_DUE
  COMPLETED
  CLOSED_NO_REPAIR
  CANCELLED

  @@map("booking_status")
}

/// The first five come from the customer; the last two are set by the system (not sent to the app yet,
/// docs/QUESTIONS.md #4).
enum CancelReason {
  PLANS_CHANGED
  FIXED
  TOO_LONG
  MISTAKE
  OTHER
  UNPAID_EXPIRED
  UNFULFILLED_EXPIRED

  @@map("cancel_reason")
}

enum CloseReason {
  CUSTOMER_DECLINED
  CUSTOMER_UNAVAILABLE
  CANNOT_COMPLETE

  @@map("close_reason")
}

enum ActorType {
  CUSTOMER
  TECHNICIAN
  COORDINATOR
  ADMIN
  SYSTEM

  @@map("actor_type")
}

/// One booking = one job. The customer sees it as a Booking, the assigned technician as a Job (same id).
model Booking {
  id                 String                                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Short human code, "HF-48291".
  code               String                                 @unique
  customerId         String                                 @map("customer_id") @db.Uuid
  serviceId          String                                 @map("service_id")
  categoryId         CategoryId                             @map("category_id")
  /// The full address at booking time (encrypted JSON), so later edits or deletion of the saved address
  /// do not change the booking.
  addressSnapshotEnc Bytes                                  @map("address_snapshot_enc")
  /// Shown to offered technicians before they accept.
  locality           String
  city               String
  pincode            String                                 @db.Char(6)
  location           Unsupported("geography(Point, 4326)")?
  issueIds           String[]                               @default([]) @map("issue_ids")
  notes              String                                 @default("")
  voiceTranscript    String?                                @map("voice_transcript")
  voiceObjectKey     String?                                @map("voice_object_key")
  voiceDurationSec   Int?                                   @map("voice_duration_sec")
  timeMode           BookingMode                            @map("time_mode")
  windowDate         DateTime?                              @map("window_date") @db.Date
  windowStartHour    Int?                                   @map("window_start_hour") @db.SmallInt
  windowEndHour      Int?                                   @map("window_end_hour") @db.SmallInt
  preferWomenRated   Boolean                                @default(false) @map("prefer_women_rated")
  status             BookingStatus
  /// The assigned technician (foreign key added with the technicians table, step 7).
  technicianId       String?                                @map("technician_id") @db.Uuid
  /// 4 digits the customer reads out at the door; encrypted because the customer must see it.
  arrivalCodeEnc     Bytes                                  @map("arrival_code_enc")
  startCodeAttempts  Int                                    @default(0) @map("start_code_attempts")
  etaMin             Int?                                   @map("eta_min")
  workStarted        Boolean                                @default(false) @map("work_started")
  cancelReason       CancelReason?                          @map("cancel_reason")
  closeReason        CloseReason?                           @map("close_reason")
  idempotencyKey     String                                 @map("idempotency_key")
  /// SHA-256 of the create request, so a reused Idempotency-Key with a different body is refused.
  idempotencyHash    Bytes                                  @map("idempotency_hash")
  /// Incremented on every change.
  version            Int                                    @default(0)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz(6)

  service  Service        @relation(fields: [serviceId], references: [id])
  customer User           @relation(fields: [customerId], references: [id])
  events   BookingEvent[]
  payments Payment[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([technicianId, status])
  @@index([status, windowDate])
  @@index([categoryId, pincode, windowDate, windowStartHour])
  @@map("bookings")
}

/// Timeline and audit of every status change.
model BookingEvent {
  id        BigInt        @id @default(autoincrement())
  bookingId String        @map("booking_id") @db.Uuid
  status    BookingStatus
  actorType ActorType     @map("actor_type")
  actorId   String?       @map("actor_id") @db.Uuid
  meta      Json          @default("{}")
  at        DateTime      @default(now()) @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, at])
  @@map("booking_events")
}

// ---------- payments (Razorpay arrives in step 6) ----------

enum PaymentKind {
  VISIT
  FINAL

  @@map("payment_kind")
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  CASH

  @@map("payment_method")
}

enum PaymentState {
  DUE
  PROCESSING
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_state")
}

model Payment {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId         String         @map("booking_id") @db.Uuid
  kind              PaymentKind
  amountPaise       BigInt         @map("amount_paise")
  state             PaymentState   @default(DUE)
  method            PaymentMethod?
  /// 'RAZORPAY' | 'CASH'
  provider          String?
  providerOrderId   String?        @unique @map("provider_order_id")
  providerPaymentId String?        @unique @map("provider_payment_id")
  providerRefundId  String?        @map("provider_refund_id")
  idempotencyKey    String?        @map("idempotency_key")
  failureCode       String?        @map("failure_code")
  /// When the payment was settled (paid, failed or refunded): Payment.at in the API.
  settledAt         DateTime?      @map("settled_at") @db.Timestamptz(6)
  /// Set when a refund was decided (cancellation before EN_ROUTE, unfulfilled); step 6 sends it to Razorpay.
  refundRequestedAt DateTime?      @map("refund_requested_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, kind])
  @@map("payments")
}
